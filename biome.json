{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "master"
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["**", "!**/*.md", "!**/*.yml", "!**/*.yaml"]
	},
	"linter": { "enabled": true, "rules": { "preset": "none" } },
	"json": { "parser": { "allowComments": true, "allowTrailingCommas": true } }
}
