{
	"name": "nabla-hooks",
	"description": "Hooks sample",
	"branchVersion": "^1.0.7",
	"branchPattern": "1.0.*",
	"version": "1.0.7",
	"author": "Alban Andrieu <alban.andrieu@free.fr> (http://albandrieu.com)",
	"license": "MIT",
	"licenses": [
		{
			"type": "MIT",
			"url": "http://www.opensource.org/licenses/MIT"
		}
	],
	"pre-commit": [
		"precommit"
	],
	"engines": {
		"node": ">=24",
		"npm": ">=10.8.2",
		"node-gyp": ">=3.0.3"
	},
	"engine-strict": true,
	"browserslist": [
		"last 1 version",
		"> 1%",
		"maintained node versions",
		"not dead"
	],
	"stylelint": {
		"plugins": [
			"stylelint-no-unsupported-browser-features"
		],
		"rules": {
			"plugin/no-unsupported-browser-features": true
		},
		"defaultSeverity": "warning"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@commitlint/cli": "^21.2.4",
		"@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
		"commitizen": "^4.2.4",
		"markdown-toc": "^1.2.0",
		"opencommit": "^3.2.7",
		"remark-cli": "^12.0.1",
		"remark-lint": "^10.0.1",
		"remark-preset-lint-recommended": "^7.0.1"
	},
	"scripts": {
		"lint-md": "remark ."
	},
	"remarkConfig": {
		"plugins": [
			"remark-preset-lint-recommended"
		]
	}
}
