#!/usr/bin/env bash
# Runtimes come from mise.toml, Python deps from uv.lock (see ONBOARDING.md).
watch_file uv.lock pyproject.toml

if has uv; then
  uv sync --locked --quiet
  export VIRTUAL_ENV="${PWD}/.venv"
  PATH_add "${VIRTUAL_ENV}/bin"
else
  log_error "uv not found: run 'mise install'"
fi

dotenv_if_exists .env
dotenv_if_exists .env.secrets
source_env_if_exists .env.local

export PROJECT_ROOT="${PWD}"
PATH_add "${PWD}"
PATH_add scripts
